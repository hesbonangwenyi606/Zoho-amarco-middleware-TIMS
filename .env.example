NODE_ENV=development
PORT=3001

LOG_LEVEL=info
DATABASE_PROVIDER=postgresql

# MOCK is development-only and never contacts the Tremol CU or KRA.
FISCAL_MODE=DISABLED
# Optional: force one safe mock retry for this Zoho invoice ID.
# MOCK_FAIL_ONCE_FOR_INVOICE_ID=
MOCK_INVOICE_NUMBER_PREFIX=TRAIN-
# Optional private ZFPLabServer URL for read-only checks only.
# Example when the server runs on this computer: http://127.0.0.1:4444
# TREMOL_ZFPLABSERVER_BASE_URL=
# TREMOL_TIMEOUT_MS=5000
# Create these invoice custom fields in Zoho Books and set each field's ID.
# Zoho write-back remains disabled until all four IDs are configured.
# ZOHO_FISCAL_STATUS_FIELD_ID=
# ZOHO_CU_NUMBER_FIELD_ID=
# ZOHO_QR_FIELD_ID=
# ZOHO_FISCALIZED_AT_FIELD_ID=

# Dedicated PostgreSQL database for Zoho Amarco development
POSTGRES_USER=your_local_db_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=your_local_db_name
DATABASE_URL=postgresql://your_local_db_user:replace_with_a_local_password@localhost:5438/your_local_db_name?schema=public
ZOHO_OAUTH_TEST_DATABASE_URL="postgresql://your_local_db_user:replace_with_a_local_password@127.0.0.1:5438/your_test_db_name?schema=public"
ZOHO_ORGANIZATION_ID=your_zoho_organization_id

ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:3001/integrations/zoho/callback
ZOHO_OAUTH_ENCRYPTION_KEY=replace_with_a_64_character_hex_key
